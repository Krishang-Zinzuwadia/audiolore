# Audio Lore Environment Configuration

# ======================
# AI API Keys
# ======================
GOOGLE_API_KEY=your_google_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ======================
# MongoDB Configuration
# ======================
# For MongoDB Atlas (Cloud):
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# For Local MongoDB:
# MONGODB_URL=mongodb://localhost:27017

# Database Name
MONGODB_DATABASE=audiolore

# ======================
# Mobile App Configuration
# ======================
# For development, use your computer's local IP address
# Find it with: ipconfig (Windows) or ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.0.102:8000

# For production, use your deployed API URL:
# EXPO_PUBLIC_API_URL=https://api.audiolore.com
